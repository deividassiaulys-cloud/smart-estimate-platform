# Settings for docker-compose.yml (feature 022, T364). Copy this file to .env next to docker-compose.yml and
# replace every value. Never commit .env: .gitignore excludes it. On the server, run: chmod 600 .env
#
# Generate each password and the key with:  openssl rand -hex 32
# Use hex only: a ';' in a password would break the connection string.
#
# IMAGE_TAG is not set here: deploy.sh (or the command line) gives the commit SHA to run.

# The public address: <server IPv4>.sslip.io (e.g. 203.0.113.10.sslip.io) or a real domain. It is used for the
# certificate and for the API's AllowedHosts. Host name only: no scheme, port or path. For a local run: localhost
SITE_ADDRESS=change-me.sslip.io

MYSQL_DATABASE=smart_estimate
# The application's database user (not root); also used by the migrations.
MYSQL_USER=smart_estimate
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# The JWT signing key: at least 32 characters (64 with openssl rand -hex 32).
JWT_KEY=change-me
