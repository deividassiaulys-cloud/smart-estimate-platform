# Smart Estimate Platform web server (feature 022, T365). Mounted into the web image by docker-compose.yml.
# One HTTPS site at SITE_ADDRESS (from the container's environment). Caddy obtains its certificate from
# Let's Encrypt and redirects HTTP to HTTPS. /api and /health go to the API on the same origin, so no CORS is
# needed. Everything else is the React client.
{
	# While trying a new address, uncomment this line to use Let's Encrypt's staging CA and avoid its rate limits:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Access log as JSON on stdout. Caddy leaves the Authorization header out of it by default; the response's
	# X-Correlation-ID is logged among the response headers.
	log {
		output stdout
		format json
	}

	# The API sets its own security headers (a stricter CSP), so none are added here.
	handle /api/* {
		reverse_proxy api:8080
	}

	handle /health* {
		reverse_proxy api:8080
	}

	# The client: files from /srv, and index.html for client routes such as /projects/5.
	handle {
		root * /srv

		# The hosted-client policy of docs/architecture.md section 4, plus HSTS and framing protection.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			Strict-Transport-Security "max-age=31536000"
			-Server
		}

		# Vite puts a hash in every asset's name, so assets may be cached for good. index.html and the other
		# files must be checked on every load, so a new deployment is picked up at once.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
